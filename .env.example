VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key
# Public app URL for signup email confirmation redirects (production). Omit locally to use window.location.origin.
# VITE_APP_URL=https://your-app.example.com
# Optional legacy JWT anon key if you are not using a publishable key:
# VITE_SUPABASE_ANON_KEY=

# Supabase dashboard: Authentication → Providers → enable Email.
# Run migrations so each table has user_id + RLS (see supabase/migrations/20260409120000_multi_user_auth.sql).
# Google Sheets sync (optional — avoids Edge Function if set):
# Enable Google Sheets API in Google Cloud Console, create an API key, restrict to Sheets API.
# VITE_GOOGLE_SHEETS_API_KEY=your_google_api_key
#
# Or deploy the sheet proxy Edge Function:
#   supabase link --project-ref YOUR_PROJECT_REF
#   supabase functions deploy google-sheet-fetch --no-verify-jwt
